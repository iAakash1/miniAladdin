# OmniSignal backend — copy to .env and fill in. Placeholders only; never
# commit real values (CI runs gitleaks on every push).

# Required: FRED macro data (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_key_here

# Optional: Alpha Vantage fundamentals + MACD (free tier: 25 req/day)
# ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Optional: NewsAPI premium headlines (falls back to Yahoo RSS without it)
# NEWSAPI_KEY=your_newsapi_key_here

# Optional: LLM explanations via Groq (free key: https://console.groq.com/keys)
# Without it, /api/research serves the engine's own rationale as fallback.
# GROQ_API_KEY=your_groq_key_here
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TIMEOUT=8
# LLM_CACHE_TTL=300

# ── Provider layer (all optional — each vendor self-disables without its key;
#    yfinance and Yahoo RSS are keyless anchors, so every chain always resolves)
# Market data:    Massive → Tiingo → Polygon → Finnhub → TwelveData → FMP
#                 → MarketStack → yfinance
#                 (order read from providers.py; yfinance is the keyless anchor)
# POLYGON_API_KEY=your_polygon_key_here
# FINNHUB_API_KEY=your_finnhub_key_here
# TWELVEDATA_API_KEY=your_twelvedata_key_here
# FMP_API_KEY=your_fmp_key_here
# MARKETSTACK_API_KEY=your_marketstack_key_here
# News:           NewsAPI → GNews → Yahoo RSS → Tavily
# GNEWS_API_KEY=your_gnews_key_here
# Search:         Tavily → Exa
# TAVILY_API_KEY=your_tavily_key_here
# EXA_API_KEY=your_exa_key_here
# Per-vendor rate override (requests/minute), e.g.:
# PROVIDER_POLYGON_RPM=5

# Optional: CORS allowlist for the API (comma-separated)
# ALLOWED_ORIGINS=https://mini-aladding.vercel.app,http://localhost:3000

# Optional: log verbosity (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# ── Persistence layer (v3.5) — all four optional; without them the API runs
#    with persistence disabled (503 on persistence endpoints, research skips
#    history recording, everything else unaffected)
# Supabase (Dashboard → Settings → API; service_role stays SERVER-ONLY)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Clerk JWT verification (JWKS URL is public; both derive from your instance)
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# ── Massive — market data ────────────────────────────────────────────────
# Leads the price, history and company chains when set. Absent, the vendor
# reports itself unavailable and every chain skips it, so the product behaves
# exactly as it did before Massive existed. Name only: never commit a value.
MASSIVE_API_KEY=

# ── Paper trading (Alpaca) ───────────────────────────────────────────────────
# Two independent controls, both required before anything can be traded.
#
# 1. Broker credentials. The endpoint is not configurable: the client
#    hardcodes https://paper-api.alpaca.markets and refuses to start against
#    any other host, so a misconfigured deployment fails closed rather than
#    reaching a live account. Name only: never commit a value.
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
#
# 2. Who may operate it. There is exactly ONE paper account behind this API,
#    shared by every caller the server accepts, so authentication alone is not
#    enough — every signed-in user would read and mutate the same positions and
#    orders. This lists the Clerk user ids permitted to use it.
#
#    It fails closed. Unset means nobody is authorised and the paper routes
#    answer 403 with the reason; an empty list must never mean "everyone".
#    Comma-separated, no spaces required.
# PAPER_TRADING_OWNERS=user_abc123,user_def456

# Comma-separated Clerk user IDs permitted to reset global metrics; empty denies everyone.
#METRICS_RESET_OWNERS=

# ── RBAC bootstrap ───────────────────────────────────────────────────────────
# Clerk user ids granted the ADMIN role without a database row. This exists
# because a fresh deployment has no administrator, so nobody could promote the
# first one. Comma-separated. Unset means nobody is an administrator, which is
# the correct default — an empty list must never mean "everyone".
# ADMIN_CLERK_USER_IDS=user_abc123,user_def456

# ── Deployment identity ──────────────────────────────────────────────────────
# The deliberate switch. When set it decides; otherwise the host markers
# (RENDER, RENDER_GIT_COMMIT, RAILWAY_ENVIRONMENT) are consulted. Set this
# rather than relying on the code recognising this year's hosting provider.
# APP_ENV=production

# ── Optional narrative critic (Gemini) ───────────────────────────────────────
# Entirely optional. Without it the product behaves exactly as it does with it,
# minus the second opinion — the deterministic validator is authoritative
# either way. The critic reviews generated prose against public evidence and
# may cause a narrative to be withheld; it can never change the signal, the
# confidence, the risk score or any number. No user data is sent to it.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TIMEOUT=8
